    "history_help_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hier werden generierte Ergebnisse nach Tag gruppiert angezeigt. Elemente mit demselben Modus und denselben Eingaben werden zusammengefasst, und du kannst nach links wischen, um einen Eintrag zu löschen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Generated results appear here grouped by day. Entries with the same mode and inputs are merged together, and you can swipe left to delete a group."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los resultados generados aparecen aquí agrupados por día. Las entradas con el mismo modo y las mismas entradas se combinan, y puedes deslizar a la izquierda para eliminar un grupo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les résultats générés apparaissent ici, regroupés par jour. Les entrées avec le même mode et les mêmes paramètres sont fusionnées, et vous pouvez balayer vers la gauche pour supprimer un groupe."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成結果は日ごとにまとめてここに表示されます。同じモードと入力の項目はひとつにまとめられ、左にスワイプしてグループを削除できます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "생성된 결과는 날짜별로 묶여 여기에 표시됩니다. 같은 모드와 입력을 가진 항목은 함께 합쳐지며, 왼쪽으로 쓸어 그룹을 삭제할 수 있습니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os resultados gerados aparecem aqui agrupados por dia. Entradas com o mesmo modo e os mesmos dados são mescladas, e você pode deslizar para a esquerda para excluir um grupo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "生成结果会按天分组显示在这里。相同模式和输入的记录会合并在一起，你可以左滑删除整组记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "產生結果會依天分組顯示在這裡。相同模式和輸入的記錄會合併在一起，你可以左滑刪除整組記錄。"
          }
        }
      }
    },
