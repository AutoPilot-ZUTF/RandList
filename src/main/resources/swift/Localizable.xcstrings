    "error_amount_below_included_count" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die Anzahl muss größer oder gleich der Anzahl enthaltener Werte sein."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amount must be greater than or equal to the number of included values."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La cantidad debe ser mayor o igual que el número de valores incluidos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La quantité doit être supérieure ou égale au nombre de valeurs incluses."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "個数は含める値の数以上である必要があります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "개수는 포함된 값의 수 이상이어야 합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A quantidade deve ser maior ou igual ao número de valores incluídos."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "数量必须大于或等于包含值的数量."
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "數量必須大於或等於包含值的數量。"
          }
        }
      }
    },
    "error_amount_exceeds_available" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
