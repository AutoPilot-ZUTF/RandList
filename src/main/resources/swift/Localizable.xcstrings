    "mode_help_exclude_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege den unteren und oberen Grenzwert fest, gib an, wie viele Zahlen du ziehen möchtest, und trage dann die Zahlen ein, die ausgeschlossen werden sollen. Die ausgeschlossenen Zahlen werden beim Generieren übersprungen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set the lower and upper bounds, enter how many numbers to generate, then list the numbers you want to exclude. Excluded numbers will be skipped during generation."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define los límites inferior y superior, indica cuántos números quieres generar y luego escribe los números que deseas excluir. Los números excluidos se omitirán al generar."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez les bornes inférieure et supérieure, indiquez combien de nombres générer, puis saisissez les nombres à exclure. Les nombres exclus seront ignorés lors de la génération."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下限と上限を設定し、生成する個数を入力してから、除外したい数字を記入します。除外した数字は生成時にスキップされます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하한과 상한을 설정하고 생성할 개수를 입력한 다음 제외할 숫자를 적으세요. 제외한 숫자는 생성할 때 건너뜁니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina os limites inferior e superior, informe quantos números deseja gerar e depois liste os números que devem ser excluídos. Os números excluídos serão ignorados na geração."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先设置下限和上限，再输入要生成的数量，然后填写要排除的数字列表。生成时会自动跳过这些被排除的数字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先設定下限和上限，再輸入要產生的數量，然後填寫要排除的數字清單。產生時會自動跳過這些被排除的數字。"
          }
        }
      }
    },
    "mode_help_include_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lege den unteren und oberen Grenzwert fest, gib die gewünschte Anzahl ein und trage dann die Zahlen ein, die unbedingt enthalten sein sollen. Diese Zahlen werden in das Ergebnis aufgenommen, solange die Anzahl ausreicht."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Set the lower and upper bounds, enter the amount you want, then list the numbers that must be included. Those numbers will be forced into the result as long as the amount is large enough."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Define los límites inferior y superior, indica la cantidad que deseas y luego escribe los números que deben incluirse. Esos números se forzarán en el resultado siempre que la cantidad sea suficiente."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Définissez les bornes inférieure et supérieure, indiquez la quantité voulue, puis saisissez les nombres qui doivent être inclus. Ces nombres seront forcés dans le résultat tant que la quantité est suffisante."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下限と上限を設定し、必要な個数を入力してから、必ず含めたい数字を記入します。個数が足りていれば、その数字は結果に必ず含まれます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하한과 상한을 설정하고 원하는 개수를 입력한 다음 반드시 포함할 숫자를 적으세요. 개수가 충분하면 그 숫자들은 결과에 반드시 포함됩니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Defina os limites inferior e superior, informe a quantidade desejada e depois liste os números que devem ser incluídos. Esses números serão obrigatoriamente inseridos no resultado, desde que a quantidade seja suficiente."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先设置下限和上限，再输入要生成的数量，然后填写必须包含的数字列表。只要数量足够，这些数字一定会出现在结果中。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "先設定下限和上限，再輸入要產生的數量，然後填寫必須包含的數字清單。只要數量足夠，這些數字一定會出現在結果中。"
          }
        }
      }
    },
    "mode_help_simple_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gib einen unteren und oberen Grenzwert sowie die gewünschte Anzahl ein. Die App zieht dann zufällige Zahlen innerhalb dieses Bereichs."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a lower bound, an upper bound, and how many numbers you want. The app will then generate random numbers within that range."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce un límite inferior, un límite superior y cuántos números deseas. La app generará números aleatorios dentro de ese rango."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Saisissez une borne inférieure, une borne supérieure et le nombre souhaité. L’app générera ensuite des nombres aléatoires dans cette plage."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "下限と上限、そして欲しい個数を入力します。アプリはその範囲内でランダムな数字を生成します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "하한과 상한, 그리고 원하는 개수를 입력하세요. 앱이 그 범위 안에서 무작위 숫자를 생성합니다."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Informe um limite inferior, um limite superior e quantos números deseja. O app gerará números aleatórios dentro desse intervalo."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "输入下限、上限和需要生成的数量，应用会在这个范围内随机生成数字。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "輸入下限、上限和需要產生的數量，App 會在這個範圍內隨機產生數字。"
          }
        }
      }
    },
    "mode_help_specify_message" : {
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Trage eine Liste von Elementen ein und gib an, wie viele ausgewählt werden sollen. Die App zieht zufällig aus genau diesen angegebenen Einträgen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enter a list of items and specify how many should be selected. The app will randomly choose only from the items you provide."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Introduce una lista de elementos e indica cuántos deben seleccionarse. La app elegirá aleatoriamente solo entre los elementos que proporciones."
          }
        },
        "fr" : {
